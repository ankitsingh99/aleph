#!/bin/sh
# Fake npm for the fake remotes (never the real one): `prefix -g` answers
# ~/.npmrc's prefix, else ~/.npm-global (`config set prefix X` writes it);
# `i -g <pkg>` "installs" by writing the package's executable (printing a
# version) into <prefix>/bin. With $ST/npm_sudo present the install reaches
# for sudo instead, like a root-owned global folder would; a package named on
# a line of $ST/install_fail fails like an offline machine.
echo "npm $*" >> "${ST:?}/log"
P="$HOME/.npm-global"
q=$(sed -n 's/^prefix=//p' "$HOME/.npmrc" 2>/dev/null | tail -n 1); [ -n "$q" ] && P=$q
[ "$1" = --version ] && { echo 11.6.1; exit 0; }
case "$1 $2" in
  "prefix -g") echo "$P"; exit 0;;
  "config set") [ "$3" = prefix ] && { echo "prefix=$4" >> "$HOME/.npmrc"; exit 0; };;
  "i -g"|"install -g")
    pkg=$3
    if [ -f "$ST/install_fail" ] && grep -qxF -- "$pkg" "$ST/install_fail"; then
      echo "npm error code ENOTFOUND"
      echo "npm error network request to https://registry.npmjs.org/$pkg failed, reason: getaddrinfo ENOTFOUND registry.npmjs.org"
      exit 1
    fi
    if [ -f "$ST/npm_sudo" ]; then echo "npm error EACCES: permission denied, mkdir '/usr/lib/node_modules'"; sudo npm i -g "$pkg"; exit 243; fi
    case $pkg in
      @google/gemini-cli) exe=gemini; ver=0.9.0;;
      @openai/codex) exe=codex; ver="codex-cli 0.50.0";;
      @qwen-code/qwen-code) exe=qwen; ver=0.1.0;;
      *) exe=${pkg##*/}; ver=1.0.0;;
    esac
    echo "npm warn deprecated something@1.0.0: fake"
    mkdir -p "$P/bin"
    printf '#!/bin/sh\necho "%s"\n' "$ver" > "$P/bin/$exe"; chmod +x "$P/bin/$exe"
    echo "added 1 package in 1s"; exit 0;;
esac
echo "fake npm: unsupported: $*" >&2; exit 1
